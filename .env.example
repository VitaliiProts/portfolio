# Публічна канонічна адреса сайту.
# Використовується для metadataBase, canonical, sitemap.xml, robots.txt, Open Graph і JSON-LD.
#
# Локально можна лишити localhost. На Vercel задайте реальний домен у
# Settings → Environment Variables. Якщо змінної немає, підставиться адреса
# продакшн-деплою Vercel, тому попередні перегляди теж мають коректні URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ключ проєкту Amplitude (аналітика та Session Replay).
# Публічний за задумом — вбудовується у клієнтський бандл під час збірки.
# На Vercel задайте його у Settings → Environment Variables, інакше аналітика
# просто не запуститься (у консолі буде попередження).
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# --- Google Ads і GA4 ---
# Якщо жодна зі змінних нижче не задана, Google tag не вантажиться взагалі.
# Тому локальна розробка й прев'ю-деплої не засмічують рекламний акаунт.

# Ідентифікатор потоку даних GA4: Admin → Data streams → Measurement ID.
NEXT_PUBLIC_GA4_ID=

# Ідентифікатор конверсії Google Ads: Goals → Conversions → Tag setup.
# Формат AW-XXXXXXXXX (без частини після слеша).
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Мітка конверсійної дії — частина після слеша в send_to.
# Одна дія «Submit lead form» на всі кнопки; розбивку по кнопках дає
# параметр cta_source у події telegram_click в GA4.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
